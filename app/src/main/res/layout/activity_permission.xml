<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_permission_status"
        android:textAppearance="?android:attr/textAppearanceLarge" />
    <TextView
        android:id="@+id/permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />
    <Button
        android:id="@+id/permission_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/button_grant_root" />
    <Button
        android:id="@+id/permission_icebox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_grant_icebox" />
    <Button
        android:id="@+id/permission_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_refresh_permissions" />
</LinearLayout>
